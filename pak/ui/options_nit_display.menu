#include "ui/menudef.h"

#define WINDOW_X		16
#define WINDOW_Y		16
#define WINDOW_WIDTH		320
#define WINDOW_HEIGHT		154
#define GROUP_NAME		"grpOptionsNitDisplay"

#include "ui/menumacros.h"

menuDef {
	name		"options_nit_display"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onESC {
		close options_nit_display ;
		open options_nit;
		}

	WINDOW( "^7N^1!^7tmod ^7Display Options^7", 94 )

#define SUBWINDOW_WIDTH		WINDOW_WIDTH-12
#define SUB_Y		26
#define SUB_H		102

	SUBWINDOW( 6, (SUB_Y), (SUBWINDOW_WIDTH), SUB_H, "^7Draw" )
	YESNO( 8, (SUB_Y)+18, (SUBWINDOW_WIDTH)-4, 10, "^7Muzzle Flash:", .2, 8, "cg_muzzleFlash", "^0Toggle Muzzle Flash" )
	MULTI( 77, (SUB_Y)+30, .55*(SUBWINDOW_WIDTH)-4, 10, "^7Bullet Tracers:", .2, 8, "cg_tracers", cvarFloatList { "No" 0 "Yes" 1 "Yes, but not my own" 2 }, "^0Toggle Bullet Tracers" )
	YESNO( 8, (SUB_Y)+42, (SUBWINDOW_WIDTH)-4, 10, "^7Explosions:", .2, 8, "cg_wolfParticles", "^0Toggle Explosions" )
	YESNO( 8, (SUB_Y)+54, (SUBWINDOW_WIDTH)-4, 10, "^7Smoke:", .2, 8, "cg_smokeparticles", "^0Toggle Smoke Particles" )
	YESNO( 8, (SUB_Y)+66, (SUBWINDOW_WIDTH)-4, 10, "^7Impact Particles:", .2, 8, "cg_impactparticles", "^0Toggle Impact Particles" ) 
	YESNO( 8, (SUB_Y)+78, (SUBWINDOW_WIDTH)-4, 10, "^7Trails:", .2, 8, "cg_trailparticles", "^0Toggle Grenade, Panzer, and Mortar Trails" )
	YESNO( 8, (SUB_Y+90), (SUBWINDOW_WIDTH)-4, 10, "^7Player Shadows:", .2, 8, "cg_shadows", "^0Toggle player shadows" )

	BUTTON( 6, (SUB_Y+106), SUBWINDOW_WIDTH, 18, "^7BACK", .3, 14, close options_nit_display ; open options_nit )

}
