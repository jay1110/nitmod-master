#include "ui/menudef.h"

// Defines //

#define WINDOW_X		16
#define WINDOW_Y		16
#define WINDOW_WIDTH	360
#define WINDOW_HEIGHT	338
#define GROUP_NAME		"grpmain"

// Macros //

#include "ui/menumacros.h"
		
// System Menu //

menuDef {
	name		"options_nit_tweak"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	fadeClamp	0.5
	fadeAmount  0.075
	
	onOpen {
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
	}

	onESC {
		close options_nit_tweak;
		open options_nit
	}

// Window //

	WINDOW( "^7N^1!^7tmod  ^7Tweaks ^7", 90 )

// Subwindows //

#define SUBWINDOW_WIDTH WINDOW_WIDTH-12
#define VIEW_Y 32
#define VIEW_HEIGHT 104
#define MOVE_Y VIEW_Y+VIEW_HEIGHT+4
#define MOVE_HEIGHT 57
#define CONNECT_Y MOVE_Y+MOVE_HEIGHT+4
#define CONNECT_HEIGHT 57
#define MEM_Y CONNECT_Y+CONNECT_HEIGHT+4
#define MEM_HEIGHT 45


// Heads Up Display //

	SUBWINDOW( 6, VIEW_Y, (SUBWINDOW_WIDTH), VIEW_HEIGHT, "^3View" )
	CVARFLOATLABEL( 8, (VIEW_Y+18), (SUBWINDOW_WIDTH)-4, 10, "cg_fov", .2, ITEM_ALIGN_RIGHT, $evalfloat((SUBWINDOW_WIDTH)-20), 8 )
	SLIDER( 8, (VIEW_Y+18), (SUBWINDOW_WIDTH)-4, 10, "Field Of View:", .2, 8, "cg_fov" 90 90 120, "Horizontal View Range (Degrees)" )
  	MULTI( 8, (VIEW_Y+30), (SUBWINDOW_WIDTH)-4, 10, "Capped FPS:", .2, 8, "com_maxfps", cvarFloatList { "No Limit" 0 "43" 43 "76" 76 "125" 125 }, "The Maximum Drawn Frames-Per-Second" )
	MULTI( 8, (VIEW_Y+42), (SUBWINDOW_WIDTH)-4, 10, "Simple Sky:", .2, 8, "r_fastsky", cvarFloatList { "Sky On" 0 "Sky Off" 1}, "Toggle Drawing The Sky" )	
	MULTI( 8, (VIEW_Y+54), (SUBWINDOW_WIDTH)-4, 10, "Atmospheric Effects:", .2, 8, "cg_atmosphericEffects", cvarFloatList { "On" 1 "Off" 0 }, "Shows Or Hides Rain/Snow Effects" )
	MULTI( 8, (VIEW_Y+66), (SUBWINDOW_WIDTH)-4, 10, "Map overbright bits:", .2, 8, "r_mapoverbrightbits", cvarFloatList { "Default" 2 "Enable" 3 }, "The World Gets Brighter, But Paler (requires vid_restart)" )
	CVARFLOATLABEL( 8, (VIEW_Y+78), (SUBWINDOW_WIDTH)-4, 10, "r_intensity", .2, ITEM_ALIGN_RIGHT, $evalfloat((SUBWINDOW_WIDTH)-20), 8 )
	SLIDER( 8, (VIEW_Y+78), (SUBWINDOW_WIDTH)-4, 10, "Intensity:", .2, 8, "r_intensity" 1.0 1.0 1.5, "The Intensity Of Textures (requires vid_restart)" )
	MULTI( 8, (VIEW_Y+90), (SUBWINDOW_WIDTH)-1, 10, "Depthbits:", .2, 8, "r_depthbits", cvarFloatList { "Default" 0 "24" 24 "32" 32 }, "The Precision Of The Depth-Buffer (Bits Per Pixel)." )

	SUBWINDOW( 6, MOVE_Y, (SUBWINDOW_WIDTH), MOVE_HEIGHT, "^3Movement" )
	MULTI( 8, (MOVE_Y+18), (SUBWINDOW_WIDTH)-4, 10, "Xhair Vertical Movement:", .2, 8, "cg_bobpitch", cvarFloatList { "Default" 0.002 "Off" 0}, "Up-Down Motion Of The Crosshair While Moving" )
	MULTI( 8, (MOVE_Y+30), (SUBWINDOW_WIDTH)-4, 10, "Body Vertical Movement:", .2, 8, "cg_bobup", cvarFloatList { "Default" 0.005 "Off" 0}, "Up-Down Motion Of The Body While Moving")
	MULTI( 8, (MOVE_Y+42), (SUBWINDOW_WIDTH)-4, 10, "Body Roll Movement:", .2, 8, "cg_bobroll", cvarFloatList { "Default" 0.002 "Off" 0}, "Rolling Motion Of The Body While Moving" )

	SUBWINDOW( 6, CONNECT_Y, (SUBWINDOW_WIDTH), CONNECT_HEIGHT, "^3Connection" )
	MULTI( 8, (CONNECT_Y+18), (SUBWINDOW_WIDTH)-4, 10, "Rate:", .2, 8, "rate", cvarFloatList { "Modem" 4000 "ISDN" 5000 "10000" 10000 "LAN/Cable/xDSL" 25000}, "Connection Speed" )
        MULTI( 8, (CONNECT_Y+30), (SUBWINDOW_WIDTH)-4, 10, "Snaps:", .2, 8, "snaps", cvarFloatList { "20 (Default)" 20 "40" 40 }, "Snapshots (Per Second) To Receive From Server" )
        MULTI( 8, (CONNECT_Y+42), (SUBWINDOW_WIDTH)-4, 10, "Maxpackets:", .2, 8, "cl_maxpackets", cvarFloatList {"30 (Default)" 30 "43" 43 "50" 50 "60" 60 "70" 70 "76" 76 "80" 80 "90" 90 "100" 100}, "Packets To Send (Per Second) From Client To Server" )

	SUBWINDOW( 6, MEM_Y, (SUBWINDOW_WIDTH), MEM_HEIGHT, "^3Memory ^7(Needs SAVE and Game Restart)" )
	MULTI( 8, (MEM_Y+18), (SUBWINDOW_WIDTH)-4, 10, "Hunkmegs:", .2, 8, "com_hunkmegs", cvarFloatList { "56MB (default - too low!)" 56 "80MB (recommended)" 80 "128MB (more than enough)" 128 }, "Memory Allocated For General Game Data" )
	MULTI( 8, (MEM_Y+30), (SUBWINDOW_WIDTH)-4, 10, "Soundmegs:", .2, 8, "com_soundmegs", cvarFloatList { "24MB (default - very low)" 24 "64MB (optimized)" 64 "180MB (RAM>1GB)" 180 }, "Memory Allocated For Sounds Only" )

// Button //
	BUTTON( 6+.5*(WINDOW_WIDTH-395)+6, WINDOW_HEIGHT-24, .5*(WINDOW_WIDTH-18), 18, "^7VID_RESTART", .3, 14,	close options_nit_tweak ; exec "vid_restart" )
	BUTTON ( 6+.5*(WINDOW_WIDTH-18)+6, WINDOW_HEIGHT-24, .5*(WINDOW_WIDTH-18), 18, "^7APPLY", .3, 14, close options_nit_tweak ; open options_nit ; exec "set cl_noprint 1;writeconfig autoexec.cfg;set cl_noprint 0" )
}

