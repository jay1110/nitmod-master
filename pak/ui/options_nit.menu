#include "ui/menudef.h"

// Defines //
#define WINDOW_X		16
#define WINDOW_Y		16
#define WINDOW_WIDTH	160
#define WINDOW_HEIGHT	248
#define GROUP_NAME		"grpOptionsnit"

// Macros //
#include "ui/menumacros.h"

// Customize Game Menu //
menuDef {
	name		"options_nit"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onESC {
		close options_nit ;
#ifdef FUI
		open main
#else
		open ingame_main
#endif // FUI
	}

// Window //
	WINDOW( "^7N^1!^7tmod", 94 )

// Subwindows //
#define SUBWINDOW_WIDTH		WINDOW_WIDTH-12
#define CONTROLS_Y 		32

// Player //
	BUTTON( 6, CONTROLS_Y, SUBWINDOW_WIDTH, 18, "^7CONTROLS", .3, 14, close options_nit ; open options_nit_controls )
	BUTTON( 6, CONTROLS_Y+24, SUBWINDOW_WIDTH, 18, "^7SOUNDS", .3, 14, close options_nit ; open options_nit_sound )	
	BUTTON( 6, CONTROLS_Y+48, SUBWINDOW_WIDTH, 18, "^7DISPLAY", .3, 14, close options_nit ; open options_nit_display )
	BUTTON( 6, CONTROLS_Y+72, SUBWINDOW_WIDTH, 18, "^7HUD", .3, 14, close options_nit ; open options_nit_hud )
	BUTTON( 6, CONTROLS_Y+96, SUBWINDOW_WIDTH, 18, "^7TWEAKS", .3, 14, close options_nit ; open options_nit_tweak )
	BUTTON( 6, CONTROLS_Y+120, SUBWINDOW_WIDTH, 18, "^7CREDITS", .3, 14, close options_nit ; open credits_nit )
	BUTTON( 6, CONTROLS_Y+144, SUBWINDOW_WIDTH, 18, "^7REPORT A BUG", .3, 14, close options_nit ; open bug_report )
	BUTTON( 6, CONTROLS_Y+168, SUBWINDOW_WIDTH, 18, "^7N^1!^7tmod DISCORD", .3, 14, close options_nit ; open nitmod_discord )

#ifdef FUI
	BUTTON( 6, WINDOW_HEIGHT-24, SUBWINDOW_WIDTH, 18, "^7BACK", .3, 14, close options_nit ; open main )
#else
	BUTTON( 6, WINDOW_HEIGHT-24, SUBWINDOW_WIDTH, 18, "^7BACK", .3, 14, close options_nit ; open ingame_main )
#endif
}

