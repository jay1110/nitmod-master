#include "ui/menudef.h"

// Defines //

#define WINDOW_X		0
#define WINDOW_Y		0
#define WINDOW_WIDTH	640
#define WINDOW_HEIGHT	480
#define GROUP_NAME		"grpDiscordConfirm"

// Macros //

#include "ui/menumacros.h"

menuDef
{
	name		"nitmod_discord"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_GRADIENT
	popup
	
	fadeClamp	0.5
	
	onOpen
	{
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
		exec "set cl_noprint 1;exec ui/nitmod_discord.cfg;set cl_noprint 0"
	}
	
	onESC
	{
		close nitmod_discord ;
		open options_nit
	}
	
// Background //

	itemDef {
		name		"background"
		rect		0 0 640 480
		style		WINDOW_STYLE_GRADIENT
		//background	"ui/assets/fadebox.tga"
		backcolor	0.01 0.01 0.01 .95
		visible		1
		decoration
	}

	itemDef {
		name		"window"
		group		GROUP_NAME
		rect		0 0 WINDOW_WIDTH WINDOW_HEIGHT
		style		WINDOW_STYLE_GRADIENT
		backcolor	0.01 0.01 0.01 .95
		border		WINDOW_BORDER_KCGRADIENT
		bordercolor	.5 .5 .5 .5
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH		218
#define SUBWINDOW_HEIGHT	80
#define SUBWINDOW_X			.5 * (WINDOW_WIDTH - SUBWINDOW_WIDTH)
#define SUBWINDOW_Y			.5 * (WINDOW_HEIGHT - SUBWINDOW_HEIGHT)

	SUBWINDOW( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "^7Join N^1!^7tmod's Discord" )
	LABEL( SUBWINDOW_X+2, SUBWINDOW_Y+16, (SUBWINDOW_WIDTH)-8, 10, "^7Click on YES to quit the game and ^7join ^7N^1!^7tmod's Discord.", .2, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-4), 8 )
	
	BUTTON( SUBWINDOW_X+6, SUBWINDOW_Y+SUBWINDOW_HEIGHT-24, .5*(SUBWINDOW_WIDTH-18), 18, "YES", .3, 14,
		close nitmod_discord ; uiScript validate_openURL )
	BUTTON( SUBWINDOW_X+6+.5*(SUBWINDOW_WIDTH-18)+6, SUBWINDOW_Y+SUBWINDOW_HEIGHT-24, .5*(SUBWINDOW_WIDTH-18), 18, "NO", .3, 14,
		close nitmod_discord ; open options_nit )
}

