#include "ui/menudef.h"
#define WINDOW_X		16
#define WINDOW_Y		16
#define WINDOW_WIDTH	300
#define WINDOW_HEIGHT	156
#define GROUP_NAME		"optControls"
#include "ui/menumacros.h"
	
menuDef {
	name		"options_nit_controls"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onESC {
		close options_nit_controls;
		open options_nit;
		}

	WINDOW( "^7N^1!^7tmod ^7Controls^7", 94 )
	
#define SUBWINDOW_WIDTH		WINDOW_WIDTH-12
#define CONTROLS_HEIGHT 	WINDOW_HEIGHT-60
#define CONTROLS_Y 		32
		
	SUBWINDOW( 6, CONTROLS_Y, (SUBWINDOW_WIDTH), CONTROLS_HEIGHT, "^7Additional controls" )
	BIND( 8, CONTROLS_Y+18, (SUBWINDOW_WIDTH)-4, 10, "^7Alternate Fire:", .2, 8, "+attack2", "^0Sniper scope, throwing knives, rifle grenade..." )
	BIND( 8, CONTROLS_Y+30, (SUBWINDOW_WIDTH)-4, 10, "^7Kill:", .2, 8, "kill;forcetapout", "^0Self Kill" )
	BIND( 8, CONTROLS_Y+42, (SUBWINDOW_WIDTH)-4, 10, "^7Playdead:", .2, 8, "playdead", "^0Simulate death" )	
	BIND( 8, CONTROLS_Y+54, (SUBWINDOW_WIDTH)-4, 10, "^7Drop Obj.:", .2, 8, "dropobj", "^0Drop objective (if enabled)" )	
	BIND( 8, CONTROLS_Y+66, (SUBWINDOW_WIDTH)-4, 10, "^7AdminChat:", .2, 8, "messagemode4", "^0Open AdminChat window" )	
	BIND( 8, CONTROLS_Y+78, (SUBWINDOW_WIDTH)-4, 10, "^7Global Stats:", .2, 8, "globalstats", "^0Open Global Stats window" )	

	BUTTON( 6, WINDOW_HEIGHT-24, SUBWINDOW_WIDTH, 18, "^7BACK", .3, 14, close options_nit_controls ; open options_nit )
}
