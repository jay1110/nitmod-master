#include "ui/menudef.h"

// Defines //

#define WINDOW_X		16
#define WINDOW_Y		16
#define WINDOW_WIDTH	380
#define WINDOW_HEIGHT	182
#define GROUP_NAME		"grpOptionsNitSound"

// Macros //

#include "ui/menumacros.h"

// Customise Game Menu //
	
menuDef {
	name		"options_nit_sound"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onESC {
		close options_nit_sound ;
		open options_nit;
		}

// Window //

	WINDOW( "^7N^1!^7tmod Sound Options^7", 94 )

// Subwindows //
#define SUBWINDOW_WIDTH		WINDOW_WIDTH-12
#define SOUND_Y			32
		
	
// Sound //

	SUBWINDOW( 6, (SOUND_Y), (SUBWINDOW_WIDTH), 78, "^7Sounds" )
	MULTI( 8, (SOUND_Y)+16, (SUBWINDOW_WIDTH)-160, 10, "^7Game Sound:", .2, 8, "s_mute", cvarFloatList { "^2On" 0 "^1Off" 1  }, "^0All Game Sounds" )
	MULTI( 8, (SOUND_Y)+28, (SUBWINDOW_WIDTH)-160, 10, "^7Hitsounds:", .2, 8, "cg_hitsounds", cvarFloatList { "^2On" 1 "^1Off" 0 }, "^0Toggle Hitsounds" )
	MULTI( 8, (SOUND_Y)+40, (SUBWINDOW_WIDTH)-160, 10, "^7TeamKill Sounds:", .2, 8, "cg_tkSounds", cvarFloatList { "^2On" 1 "^1Off" 0  }, "^0Enable or Disable the 'TeamKiller' sound" )
	MULTI( 8, (SOUND_Y)+52, (SUBWINDOW_WIDTH)-160, 10, "^7Goat Sounds:", .2, 8, "cg_goatSound", cvarFloatList { "^7Stab" 1 "^7Throw" 2 "^7Stab + Throw" 3 "^1Off" 0 }, "^0Knife kills sounds" )
	MULTI( 8, (SOUND_Y)+64, (SUBWINDOW_WIDTH)-160, 10, "^7Shove Sounds:", .2, 8, "cg_shoveSounds", cvarFloatList { "^2On" 1 "^1Off" 0  }, "^0Play shove sounds" )

	SUBWINDOW( 6, (SOUND_Y)+82, (SUBWINDOW_WIDTH), 40, "^7Voices & Chat" )
	MULTI( 8, (SOUND_Y)+96, (SUBWINDOW_WIDTH)-160, 10, "^7Chat Voice:", .2, 8, "cg_noVoiceChats", cvarFloatList { "^2On" 0 "^1Off" 1  }, "^0voice chats on/off" )
	MULTI( 8, (SOUND_Y)+108, (SUBWINDOW_WIDTH)-160, 10, "^7Chat Text:", .2, 8, "cg_noVoiceText", cvarFloatList { "^2On" 0 "^1Off" 1  }, "^0voice text on/off" )

	BUTTON( 6, WINDOW_HEIGHT-24, SUBWINDOW_WIDTH, 18, "^7BACK", .3, 14, close options_nit_sound ; open options_nit )


}
